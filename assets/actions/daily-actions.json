      "requirements": [{ "stat": "ENERGY", "minimum": 10 }],
      "allowedPeriods": ["NORMAL", "OFFSEASON"],
      "deltas": [
        { "stat": "ENERGY", "delta": -10, "source": "ACTION_BASE" },
        { "stat": "BALANCE", "delta": 180, "source": "RANDOM_OUTCOME", "randomRange": { "maximum": 300 } },
        { "stat": "STRESS", "delta": 6, "source": "ACTION_BASE" }
      ]
    },
    {
      "id": "rest",
      "type": "REST",
      "name": "休息",
