      "deltas": [
        { "stat": "ENERGY", "delta": 30, "source": "ACTION_BASE" },
        { "stat": "MORALE", "delta": 12, "source": "ACTION_BASE" },
        { "stat": "STRESS", "delta": -10, "source": "ACTION_BASE" }
      ]
    },
    {
      "id": "review-demo",
      "type": "REVIEW_DEMO",
      "name": "复盘 Demo",
      "description": "拆解比赛细节，提升比赛理解。",
      "durationHours": 3,
      "requirements": [{ "stat": "ENERGY", "minimum": 15 }],
      "allowedPeriods": ["NORMAL", "OFFSEASON", "TOURNAMENT_BREAK"],
      "deltas": [
        { "stat": "ENERGY", "delta": -12, "source": "ACTION_BASE" },
        { "stat": "ATTRIBUTE", "attribute": "GAME_SENSE", "delta": 1, "source": "ACTION_BASE", "randomBonus": { "threshold": 0.75, "delta": 2 } }
