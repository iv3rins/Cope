{
  "id": "fan-message",
  "worldlineId": "shared",
  "title": "一条私信",
  "description": "连败之后，你打开私信想关掉评论，第一条是那个老粉丝发来的：\"输赢都看你。\"",
  "period": "NORMAL",
  "type": "CHOICE",
  "repeatable": false,
  "priority": 60,
