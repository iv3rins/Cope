      "description": "\"下一场，我打给你看。\"",
      "requirements": [],
      "successChance": { "baseChance": 0.8, "modifiers": [] },
      "outcome": {
        "successEffects": [
          { "type": "PLAYER_STAT_CHANGE", "stat": "MORALE", "delta": 7 },
          { "type": "NARRATIVE_METRIC_CHANGE", "metric": "FAN_REPUTATION", "delta": 3 }
