        "failureEffects": [
          { "type": "PLAYER_STAT_CHANGE", "stat": "MORALE", "delta": 2 }
        ],
        "successMessages": [
          "他回了一串感叹号，你盯着屏幕笑了。"
        ],
        "failureMessages": [
          "他回得很快：\"别勉强，照顾好自己。\""
        ],
        "successNextEventId": null,
        "failureNextEventId": null
      }
    },
    {
      "id": "close-app",
      "label": "关掉手机",
      "description": "现在的你，配不上这句\"输赢都看你\"。",
      "requirements": [],
      "successChance": { "baseChance": 0.5, "modifiers": [] },
      "outcome": {
        "successEffects": [
          { "type": "PLAYER_STAT_CHANGE", "stat": "ENERGY", "delta": 2 }
        ],
        "failureEffects": [
          { "type": "PLAYER_STAT_CHANGE", "stat": "MORALE", "delta": -5 }
        ],
        "successMessages": [
          "你关掉手机，去训练室打了四小时。"
        ],
        "failureMessages": [
          "你关掉手机，在训练室坐到凌晨。"
        ],
        "successNextEventId": null,
        "failureNextEventId": null
      }
    }
